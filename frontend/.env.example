# =============================================
# Frontend Environment Variables
# Copy this file to .env.local for development
# =============================================

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google Maps API Key (optional - defaults to Leaflet/OpenStreetMap if not set)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# Site config
NEXT_PUBLIC_SITE_NAME=BinHorizon
NEXT_PUBLIC_SITE_URL=https://vietrealestate.vn

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Supabase - BinHorizon (Singapore ap-southeast-1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # server-side only, never expose
