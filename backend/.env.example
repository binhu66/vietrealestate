# =============================================
# Backend Environment Variables
# Copy this file to .env for development
# =============================================

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# JWT Secret - change this to a strong random string in production
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# Database (future - currently uses in-memory data)
# DB_URL=mongodb://localhost:27017/vietrealestate
# DB_URL=postgresql://user:password@localhost:5432/vietrealestate

# File uploads (future)
# UPLOAD_DIR=./uploads
# MAX_FILE_SIZE=10mb

# Email (future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@email.com
# SMTP_PASS=your_app_password

# SMS/OTP for Vietnam phone verification (future)
# TWILIO_ACCOUNT_SID=xxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_PHONE_NUMBER=+84xxxxxxxxx

# Vietnam address API (future)
# VIET_ADDRESS_API_KEY=your_key_here
